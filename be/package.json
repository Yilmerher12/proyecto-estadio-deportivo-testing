{
  "name": "estadio-deportivo-semana-10-uploads-emails",
  "version": "1.0.0",
  "description": "Estadio Deportivo — API de concesiones con uploads (Cloudinary) y emails (Nodemailer)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcrypt": "5.1.1",
    "cloudinary": "2.6.1",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.13.2",
    "multer": "2.4.0",
    "nodemailer": "6.10.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.1",
    "@types/jsonwebtoken": "9.0.9",
    "@types/multer": "1.4.12",
    "@types/node": "22.14.1",
    "@types/nodemailer": "6.4.17",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "supertest": "7.3.2",
    "tsx": "4.19.3",
    "typescript": "5.8.3",
    "vitest": "5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt"
    ]
  }
}
